<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One package source, so central package management restores the same way on every machine (avoids NU1507). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
