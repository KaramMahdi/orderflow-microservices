# Copy this file to .env and replace every <...> placeholder. Never commit .env.

# ---------------------------------------------------------------
# Images
# ---------------------------------------------------------------
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
SQL_SERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
HOST_IMAGE=orderflow-host:local

# ---------------------------------------------------------------
# Shared
# ---------------------------------------------------------------
# One time zone for every container (ADR-0004), IANA name, for example Asia/Amman.
SERVER_TIMEZONE=<iana-time-zone>
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

# ---------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------
# Y accepts the SQL Server license terms (required by the image).
SQL_ACCEPT_EULA=<Y-to-accept-the-sql-server-license>
SQL_PRODUCT_ID=Developer
# Passwords: at least 8 characters with three of: upper case, lower case, digits, symbols.
# No single quote ('), and no $ (Compose would read it as a variable).
SQL_SA_PASSWORD=<strong-sa-password>
# Login the host uses instead of sa (created by the sqlserver-init service, role dbcreator).
SQL_APP_LOGIN=www
SQL_APP_PASSWORD=<strong-app-password>
SQL_PORT=1433
# master until the DbMigrator creates the OrderFlow database (Milestone 5).
SQL_DATABASE=master
SQL_MEM_LIMIT=2g
SQL_MEMORY_LIMIT_MB=1536
SQL_HEALTHCHECK_START_PERIOD=30s
SQL_INIT_MEM_LIMIT=128m

# ---------------------------------------------------------------
# Host (OrderFlow.HttpApi.Host)
# ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
HOST_HTTP_PORT=8080
HOST_CONTAINER_PORT=8080
HOST_MEM_LIMIT=512m
HOST_HEALTHCHECK_START_PERIOD=15s
